# Flutter Podfile (Clean Version)

# Get Flutter root from Generated.xcconfig
def flutter_root
  config_path = File.expand_path('../Flutter/Generated.xcconfig', __FILE__)

  unless File.exist?(config_path)
    raise "#{config_path} must exist. Run 'flutter pub get' first"
  end

  File.foreach(config_path) do |line|
    match = line.match(/^FLUTTER_ROOT=(.*)$/)
    return match[1].strip if match
  end

  raise "FLUTTER_ROOT not found in #{config_path}. Delete Generated.xcconfig and run 'flutter pub get'"
end

require File.expand_path('packages/flutter_tools/bin/podhelper', flutter_root)

# iOS platform version
platform :ios, '12.0'

# Disable analytics for faster CI
install! 'cocoapods', deterministic_uuids: false

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods(File.dirname(File.realpath(__FILE__)))
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    target.build_configurations.each do |config|
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= [
        '$(inherited)',

        # Permissions (Location enabled)
        'PERMISSION_LOCATION=1',
      ]
    end
  end
end